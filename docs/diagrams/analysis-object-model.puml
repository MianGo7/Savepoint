@startuml analysis-object-model
!include _style.puml

package "Entity objects" {
  class User <<entity>>
  class Project <<entity>> {
    name
    archived_at
  }
  class Task <<entity>> {
    title
    description
    estimate_minutes
    branch_name
    status
    completed_at
  }
  class WorkSession <<entity>> {
    started_at
    ended_at
  }
  class ResumePoint <<entity>> {
    where_stopped
    next_step
  }
  enum TaskStatus <<entity>> {
    Todo
    Active
    Paused
    Completed
  }
}

package "Boundary objects" {
  class "pages::projects.index" as ProjectsIndex <<boundary>>
  class "pages::projects.show" as ProjectsShow <<boundary>>
  class "pages::tasks.form" as TasksForm <<boundary>>
  class "pages::tasks.start" as TasksStart <<boundary>>
  class "pages::dashboard" as Dashboard <<boundary>>
  class "pages::reports.time" as ReportsTime <<boundary>>
}

package "Control objects" {
  class CreateProject <<control>>
  class RenameProject <<control>>
  class ArchiveProject <<control>>
  class DeleteProject <<control>>
  class CreateTask <<control>>
  class UpdateTask <<control>>
  class DeleteTask <<control>>
  class StartTask <<control>>
  class PauseTask <<control>>
  class SwitchTask <<control>>
  class ResumeTask <<control>>
  class CompleteTask <<control>>
  class OpenWorkSession <<control>>
  class OverviewQuery <<control>>
  class TimeReportQuery <<control>>
}

User "1" -- "0..*" Project
Project "1" -- "0..*" Task
User "1" -- "0..*" Task
Task "1" -- "0..*" WorkSession
User "1" -- "0..*" WorkSession
Task "1" -- "0..*" ResumePoint
WorkSession "1" -- "0..1" ResumePoint
Task --> TaskStatus

ProjectsIndex ..> CreateProject
ProjectsIndex ..> RenameProject
ProjectsIndex ..> ArchiveProject
ProjectsIndex ..> DeleteProject
ProjectsShow ..> DeleteTask
TasksForm ..> CreateTask
TasksForm ..> UpdateTask
TasksStart ..> StartTask
TasksStart ..> ResumeTask
TasksStart ..> SwitchTask
Dashboard ..> PauseTask
Dashboard ..> CompleteTask
Dashboard ..> OverviewQuery
ReportsTime ..> TimeReportQuery

CreateProject ..> Project
RenameProject ..> Project
ArchiveProject ..> Project
DeleteProject ..> Project
CreateTask ..> Task
UpdateTask ..> Task
DeleteTask ..> Task
StartTask ..> OpenWorkSession
ResumeTask ..> OpenWorkSession
OpenWorkSession ..> Task
OpenWorkSession ..> WorkSession
PauseTask ..> WorkSession
PauseTask ..> ResumePoint
SwitchTask ..> PauseTask
SwitchTask ..> StartTask
SwitchTask ..> ResumeTask
CompleteTask ..> Task
CompleteTask ..> WorkSession
OverviewQuery ..> Task
OverviewQuery ..> ResumePoint
TimeReportQuery ..> WorkSession

@enduml
